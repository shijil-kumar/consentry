# Consentry — environment template.
# Copy to .env.local and fill in. Never commit the filled copy: .gitignore
# excludes .env* for exactly that reason.

# ── Supabase (required) ─────────────────────────────────────────────────────
# The service role key bypasses RLS. It is read only in server code and in
# scripts; if it ever appears in a NEXT_PUBLIC_* var, that is a leak.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── App ─────────────────────────────────────────────────────────────────────
APP_BASE_URL=http://localhost:3000
NEXT_PUBLIC_PLATFORM_NAME=Consentry

# ── The script gate (required for the rules check) ──────────────────────────
# Without a key the gate cannot run and no script can be judged.
ANTHROPIC_API_KEY=
POLICY_LLM=anthropic
POLICY_MODEL=claude-haiku-4-5

# ── Video engines (optional — the app runs on the mock engine without any) ──
# VIDEO_PROVIDER=mock leaves every render on the free stub, which still applies
# the visible AI label and the C2PA seal for real.
VIDEO_PROVIDER=mock
TAVUS_API_KEY=
TAVUS_WEBHOOK_TOKEN_SECRET=
HEYGEN_API_KEY=
HEYGEN_VOICE_ID=
HEYGEN_ALLOW_ENDUSER_GEN=0
DID_API_KEY=
DID_VOICE_ID=

# ── Consent verification (optional) ─────────────────────────────────────────
# Speech-to-text for the spoken consent phrase; Groq is the fallback.
ELEVENLABS_API_KEY=
GROQ_API_KEY=
REALITY_DEFENDER_API_KEY=

# ── Payments (optional — PAYMENT_PROVIDER=mock needs none) ──────────────────
PAYMENT_PROVIDER=mock
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ── C2PA signing ────────────────────────────────────────────────────────────
# PEM-encoded cert chain and private key, supplied as environment variables so
# no key is ever committed. Without them the pipeline still burns in the
# visible AI label and records the hash, and says the file is unsigned rather
# than pretending otherwise. For local work, c2patool's published ES256 sample
# pair is enough; a real deployment needs a certificate from a recognised
# authority.
C2PA_CERT_PEM=
C2PA_KEY_PEM=

# ── Secrets for internal callers ────────────────────────────────────────────
# Long random strings. CRON_SECRET authenticates the background worker;
# CONSENT_CHALLENGE_SECRET signs the spoken-phrase challenge.
CRON_SECRET=
JOBS_SECRET=
CONSENT_CHALLENGE_SECRET=

# ── Local development only ──────────────────────────────────────────────────
# DEV_OPEN=1 enables /api/dev/login, a password-free role switcher. It returns
# 404 unless NODE_ENV is not production, and must stay 0 anywhere public.
DEV_OPEN=0
NEXT_PUBLIC_DEV_OPEN=0
DEMO_PASSWORD=
DEMO_SAFE_MODE=1
